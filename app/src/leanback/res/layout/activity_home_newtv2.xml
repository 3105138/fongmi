<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/newtv2Hero"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:background="@drawable/bg_newtv2_hero"
        android:clipChildren="false">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/newtv2HeroPoster"
            android:layout_width="236dp"
            android:layout_height="315dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="76dp"
            android:background="@drawable/bg_newtv2_poster"
            android:clipToOutline="true"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_newtv2_hero_scrim"
            android:clickable="false"
            android:focusable="false" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="48dp"
            android:layout_marginBottom="44dp"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/newtv2_hero_label"
                android:textColor="#E58A45"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/newtv2HeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="影视盒子"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                tools:text="精选影片标题" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/newtv2HeroRemark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/newtv2_hero_subtitle"
                android:textColor="#B8C0CC"
                android:textSize="16sp"
                tools:text="更新中 · 当前配置源" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>

    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="440dp"
            android:paddingEnd="48dp"
            android:paddingBottom="20dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

    </com.fongmi.android.tv.ui.custom.ProgressLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="22dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/newtv2NavHome"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_newtv2_nav"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="64dp"
            android:nextFocusDown="@id/recycler"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:selected="true"
            android:text="@string/newtv2_nav_home"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/newtv2NavVod"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_newtv2_nav"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="64dp"
            android:nextFocusDown="@id/recycler"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/newtv2_nav_vod"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/newtv2NavLive"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_newtv2_nav"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="64dp"
            android:nextFocusDown="@id/recycler"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/newtv2_nav_live"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/newtv2NavSearch"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_newtv2_nav"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="64dp"
            android:nextFocusDown="@id/recycler"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/newtv2_nav_search"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/newtv2NavKeep"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_newtv2_nav"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="64dp"
            android:nextFocusDown="@id/recycler"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/newtv2_nav_keep"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/newtv2NavConnect"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_newtv2_nav"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="64dp"
            android:nextFocusDown="@id/recycler"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/newtv2_nav_connect"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.fongmi.android.tv.ui.custom.CustomTitleView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/selector_newtv2_nav"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxWidth="190dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:nextFocusDown="@id/recycler"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/newtv2NavSetting"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/selector_newtv2_nav"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="64dp"
            android:nextFocusDown="@id/recycler"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/newtv2_nav_setting"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="21:36" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
